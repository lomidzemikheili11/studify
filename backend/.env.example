SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Studify" <no-reply@studify.com>

# Otomatik mesaj çevirisi (isteğe bağlı — doldurulmazsa mesajlar
